    {
        "id": "7199e3140884c34e",
        "type": "function",
        "z": "2746c6ca368542e3",
        "name": "function 1",
        "func": "// msg.payload sudah berupa objek JSON hasil parse\nconst d = msg.payload;\n\n// Validasi field penting\nif (!d.ts) {\n    node.warn(\"Payload tidak memiliki field ts, dilewati\");\n    return null; // hentikan alur\n}\n\nmsg.topic = `INSERT INTO weather_data \n    (ts, tmp, hum, wnd, knt, ang, dir, rn, lx) \n    VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?)`;\n\nmsg.payload = [\n    d.ts,\n    d.tmp,\n    d.hum,\n    d.wnd,\n    d.knt,\n    d.ang,\n    d.dir,\n    d.rn,\n    d.lx\n];\n\nreturn msg;",
