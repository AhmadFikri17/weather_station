        "z": "b91c08e9e348ed24",
        "name": "function 2",
        "func": "// Ambil parameter opsional dari query string, misal ?limit=50\nconst limit = parseInt(msg.req.query.limit) || 100;\nconst safeLimit = Math.min(Math.max(limit, 1), 1000); // batasi 1-1000\n\nmsg.topic = `SELECT * FROM weather_data ORDER BY ts DESC LIMIT ${safeLimit}`;\nreturn msg;\n",
